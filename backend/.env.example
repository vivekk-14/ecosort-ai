# EcoSort AI Backend Environment Variables

# AI Provider choice: 'gemini' or 'mock' (or 'openai')
# Default is 'gemini' if key is provided, falls back to 'mock' if no key is set.
AI_PROVIDER=gemini

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model name (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-2.5-flash)
AI_MODEL=gemini-1.5-flash

# Backend Server Port
PORT=8000
